{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "apps": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "reminders": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "telegramConnector": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "appId": {
              "type": "string"
            }
          }
        }
      }
    },
    "runners": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "k8s": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "external"
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKeyPattern": {
              "type": "string"
            }
          },
          "required": [
            "mode"
          ]
        }
      }
    }
  }
}
