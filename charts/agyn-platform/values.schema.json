        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "users": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "ziti-management": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
