        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "chat": {
      "type": "object",
