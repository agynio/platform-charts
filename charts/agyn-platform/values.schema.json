                "managed",
                "external"
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKeyPattern": {
              "type": "string"
            }
          },
          "required": [
            "mode"
          ]
        },
        "oidc": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "issuerUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            }
          }
        }
      }
    },
    "openfga": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "apiUrl": {
          "type": "string"
