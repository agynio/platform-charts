{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "secretRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    },
    "databaseSecretRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "databaseUrlRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    },
    "s3CredentialRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    },
    "natsStream": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "retention": {
          "type": "string"
        },
        "storage": {
          "type": "string",
          "enum": [
            "file",
            "memory"
          ]
        },
        "discard": {
          "type": "string"
        },
        "maxAge": {
          "type": "string"
        },
        "maxBytes": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "duplicateWindow": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "subjects"
      ]
    }
  },
  "properties": {
    "s3": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "accessKeyKey": {
          "type": "string"
        },
        "secretKeyKey": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "bucket": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "useSSL": {
          "type": "boolean"
        },
        "forcePathStyle": {
          "type": "boolean"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "sslMode": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "redis": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "externalAddress": {
              "type": "string"
            }
          }
        }
      }
    },
    "nats": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fullnameOverride": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "jetstream": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "fileStore": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "dir": {
                      "type": "string"
                    },
                    "maxSize": {
                      "type": "string"
                    },
                    "pvc": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "size": {
                          "type": "string"
                        },
                        "storageClassName": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                },
                "memoryStore": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "streams": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "image": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "repository": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string"
                    },
                    "pullPolicy": {
                      "type": "string"
                    }
                  }
                },
                "backoffLimit": {
                  "type": "integer",
                  "minimum": 0
                },
                "restartPolicy": {
                  "type": "string",
                  "enum": [
                    "Never",
                    "OnFailure"
                  ]
                },
                "replicas": {
                  "type": "integer",
                  "minimum": 1
                },
                "retention": {
                  "type": "string"
                },
                "storage": {
                  "type": "string",
                  "enum": [
                    "file",
                    "memory"
                  ]
                },
                "discard": {
                  "type": "string"
                },
                "maxAge": {
                  "type": "string"
                },
                "maxBytes": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "duplicateWindow": {
                  "type": "string"
                },
                "waitTimeout": {
                  "type": "string"
                },
                "definitions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/natsStream"
                  }
                }
              }
            }
          }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "serviceEndpoints": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "egress": {
              "type": "string"
            },
            "authorization": {
              "type": "string"
            },
            "notifications": {
              "type": "string"
            },
            "secrets": {
              "type": "string"
            },
            "metering": {
              "type": "string"
            },
            "tracing": {
              "type": "string"
            },
            "zitiManagement": {
              "type": "string"
            },
            "nats": {
              "type": "string"
            }
          }
        },
        "eventBus": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "url": {
              "type": "string"
            },
            "urlEnvName": {
              "type": "string"
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "external"
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKeyPattern": {
              "type": "string"
            }
          },
          "required": [
            "mode"
          ]
        },
        "oidc": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "issuerUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "audience": {
              "type": "string"
            }
          }
        }
      }
    },
    "openfga": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "apiUrl": {
          "type": "string"
        },
        "storeId": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "requireExistingSecrets": {
          "type": "boolean"
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "egress-gateway": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "agents-orchestrator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "expose": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "organizations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "runners": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "threads": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "users": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "ziti-management": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "env": {
          "type": "array"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "database": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": {
              "$ref": "#/definitions/databaseSecretRef"
            }
          }
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "llm": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "databaseUrl": {
              "$ref": "#/definitions/databaseUrlRef"
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "files": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "databaseUrl": {
              "$ref": "#/definitions/databaseUrlRef"
            },
            "s3": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "endpoint": {
                  "type": "string"
                },
                "bucket": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "useSSL": {
                  "type": "boolean"
                },
                "accessKey": {
                  "$ref": "#/definitions/s3CredentialRef"
                },
                "secretKey": {
                  "$ref": "#/definitions/s3CredentialRef"
                }
              }
            }
          }
        },
        "env": {
          "type": "array"
        }
      }
    }
  }
}
